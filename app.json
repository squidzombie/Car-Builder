{
  "expo": {
    "name": "Card Builder",
    "slug": "cardbuilder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maxlockleer.cardbuilder",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.maxlockleer.cardbuilder",
      "adaptiveIcon": {
        "backgroundColor": "#0b0e19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Card Builder uses your photo library so you can put your photos on cards."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "34691873-a81f-43da-9f32-7c40d7b00096"
      }
    },
    "owner": "squidzombie"
  }
}
